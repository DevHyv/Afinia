#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import FadeTransition kivy.uix.screenmanager.FadeTransition

# Layout Principal que contiene las pantallas y la barra inferior
BoxLayout:
    orientation: 'vertical'

    # Gestor de Pantallas
    ScreenManager:
        id: sm
        transition: FadeTransition(duration=0.2)
        TunerScreen:
            name: 'tuner'
        TransposerScreen:
            name: 'transposer'

    # Barra de Navegación Inferior
    BoxLayout:
        size_hint_y: None
        height: dp(60)
        padding: dp(5)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: get_color_from_hex('#1A1A1A')
            Rectangle:
                pos: self.pos
                size: self.size

        Button:
            text: 'Afinador'
            font_size: sp(16)
            bold: True
            background_normal: ''
            background_color: get_color_from_hex('#3D3D5C') if sm.current == 'tuner' else get_color_from_hex('#2A2A2A')
            on_release: sm.current = 'tuner'

        Button:
            text: 'Transpositor'
            font_size: sp(16)
            bold: True
            background_normal: ''
            background_color: get_color_from_hex('#3D3D5C') if sm.current == 'transposer' else get_color_from_hex('#2A2A2A')
            on_release: sm.current = 'transposer'

<TunerScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(16)

        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(8)

            Button:
                text: 'Afinia'
                font_size: sp(28)
                bold: True
                color: get_color_from_hex('#D4A5D4')
                background_color: (0,0,0,0)
                on_release: app.open_paypal()

            Spinner:
                id: instrument_spinner
                text: 'Guitarra (6 cuerdas)'
                values: ['Guitarra (6 cuerdas)', 'Bajo', 'Ukelele']
                size_hint_x: 0.6
                height: dp(48)
                background_normal: ''
                background_color: get_color_from_hex('#1E1E1E')
                font_size: sp(16)
                on_text: root.on_instrument_change(self.text)

        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(8)

            Button:
                id: mic_btn
                text: 'Activar micrófono'
                font_size: sp(16)
                bold: True
                on_release: root.toggle_microphone()
                background_normal: ''
                background_color: get_color_from_hex('#3D3D5C')

            BoxLayout:
                spacing: dp(2)
                Button:
                    id: btn_auto
                    text: 'Auto'
                    background_normal: ''
                    background_color: get_color_from_hex('#3D3D5C')
                    on_release: root.set_mode('auto')
                Button:
                    id: btn_manual
                    text: 'Manual'
                    background_normal: ''
                    background_color: get_color_from_hex('#2A2A2A')
                    on_release: root.set_mode('manual')

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(120)
            spacing: dp(4)

            Label:
                id: lbl_note
                text: '–'
                font_size: sp(72)
                bold: True
                color: '#FFFFFF'
            Label:
                id: lbl_freq
                text: '0.0 Hz'
                font_size: sp(20)
                color: '#B0B0B0'

        ProgressBar:
            id: cent_bar
            max: 100
            value: 50
            size_hint_y: None
            height: dp(24)

        Label:
            id: lbl_cents
            text: '––'
            font_size: sp(28)
            bold: True
            size_hint_y: None
            height: dp(48)
            color: '#FFFFFF'

        GridLayout:
            id: strings_grid
            cols: 3
            spacing: dp(10)
            size_hint_y: 1

<TransposerScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(16)

        Label:
            text: 'Transpositor de Acordes'
            font_size: sp(24)
            bold: True
            size_hint_y: None
            height: dp(48)
            color: get_color_from_hex('#D4A5D4')

        TextInput:
            id: input_chords
            text: 'Sol  Mim  Lam  Re7'
            multiline: True
            size_hint_y: 0.3
            background_normal: ''
            background_color: get_color_from_hex('#1E1E1E')
            foreground_color: '#FFFFFF'
            padding: (dp(12), dp(12))
            font_size: sp(18)

        GridLayout:
            cols: 2
            spacing: dp(12)
            size_hint_y: None
            height: dp(56)

            Spinner:
                id: spin_from
                text: 'Sol (G)'
                values: ['Do (C)','Do# (C#)','Re (D)','Re# (D#)','Mi (E)','Fa (F)','Fa# (F#)','Sol (G)','Sol# (G#)','La (A)','La# (A#)','Si (B)']
                background_normal: ''
                background_color: get_color_from_hex('#2A2A2A')
                font_size: sp(16)
            Spinner:
                id: spin_to
                text: 'Do (C)'
                values: ['Do (C)','Do# (C#)','Re (D)','Re# (D#)','Mi (E)','Fa (F)','Fa# (F#)','Sol (G)','Sol# (G#)','La (A)','La# (A#)','Si (B)']
                background_normal: ''
                background_color: get_color_from_hex('#2A2A2A')
                font_size: sp(16)

        Spinner:
            id: spin_format
            text: 'Español (Do, Re, Mi...)'
            values: ['Español (Do, Re, Mi...)', 'Anglo (C, D, E...)']
            size_hint_y: None
            height: dp(56)
            background_normal: ''
            background_color: get_color_from_hex('#2A2A2A')
            font_size: sp(16)

        Button:
            text: 'Transponer'
            size_hint_y: None
            height: dp(60)
            bold: True
            background_normal: ''
            background_color: get_color_from_hex('#3D3D5C')
            font_size: sp(20)
            on_release: root.process_transpose()

        ScrollView:
            size_hint_y: 0.5
            Label:
                id: lbl_output
                text: 'Do  Lam  Rem  Sol7'
                color: get_color_from_hex('#8BC34A')
                font_size: sp(24)
                bold: True
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: 'center'
                valign: 'middle'
